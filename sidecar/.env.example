# Telegram credentials — from https://my.telegram.org (dedicated/expendable account only,
# see docs/TELEGRAM_OSINT_PRD.md#account-safety). Never commit the real .env or .session file.
TG_API_ID=
TG_API_HASH=

# OpenAI key for relevance classification and entity extraction (gpt-4o-mini).
OPENAI_API_KEY=

# Path to the .gpkg the sidecar reads (read-only) for OOB match proposals (Phase 7).
# Leave unset until Phase 7; /health does not require it.
GPKG_PATH=
